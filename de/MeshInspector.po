msgstr ""
"Ausgewählte Objekte sind weder ObjectMesh, ObjectPoints noch FeatureObject, "
"die an ObjectMesh oder ObjectPoints angefügt sind"

msgid "Feature Type"
msgstr "Feature-Typ"

msgid ""
"Click on point/mesh surface. Picked points can be dragged after creation."
msgstr ""
"Klicken Sie auf Punkt-/Mesh-Oberfläche. Ausgewählte Punkte können nach "
"Erstellung gezogen werden."

#, c-format
msgid "Hold %s button to magnetize points to the mesh edges."
msgstr "Halten Sie die Taste %s, um Punkte an Mesh-Kanten zu magnetisieren."

msgid "Click with Shift button to remove a point."
msgstr "Mit Umschalttaste klicken, um einen Punkt zu entfernen."

msgid "Select with:"
msgstr "Auswählen mit:"

msgid "Pick mesh boundary"
msgstr "Mesh-Rand auswählen"

msgid "Pick sub-feature"
msgstr "Unter-Feature auswählen"

msgid "Creating a derived feature is not supported for this feature type."
msgstr ""
"Erstellen eines abgeleiteten Features wird für diesen Feature-Typ nicht "
