msgstr "Achse"

msgid "To X"
msgstr "Zu X"

msgid "Set axis to X"
msgstr "Achse auf X setzen"

msgid "To Y"
msgstr "Zu Y"

msgid "Set axis to Y"
msgstr "Achse auf Y setzen"

msgid "To Z"
msgstr "Zu Z"

msgid "Set axis to Z"
msgstr "Achse auf Z setzen"

msgid "Set axis to camera"
msgstr "Achse auf Kamera setzen"

msgid "To -X"
msgstr "Zu -X"

msgid "Set axis to -X"
msgstr "Achse auf -X setzen"

msgid "To -Y"
msgstr "Zu -Y"

msgid "Set axis to -Y"
msgstr "Achse auf -Y setzen"

msgid "To -Z"
msgstr "Zu -Z"

msgid "Set axis to -Z"
msgstr "Achse auf -Z setzen"

