msgid "Discard the changes and start from scratch"
msgstr "Änderungen verwerfen und von vorne beginnen"

msgid "Target Object"
msgstr "Zielobjekt"

msgid "Refine object"
msgstr "Objekt verfeinern"

msgid "Distance Limit"
msgstr "Abstandsgrenze"

