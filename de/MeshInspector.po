msgid "BestFit {}"
msgstr "BestFit {}"

msgid "Union"
msgstr "Vereinigung"

msgid "Intersection"
msgstr "Schnittmenge"

msgid "Difference"
msgstr "Differenz"

msgid "Object A"
msgstr "Objekt A"

msgid "Object B"
msgstr "Objekt B"

msgid "Leave only largest"
msgstr "Nur größte beibehalten"

msgid "Select two closed meshes"
msgstr "Zwei geschlossene Meshes auswählen"

msgid "Add boolean result"
msgstr "Boolesches Ergebnis hinzufügen"

msgid "Bridge Fill All Holes"
msgstr "Alle Löcher überbrücken und füllen"

