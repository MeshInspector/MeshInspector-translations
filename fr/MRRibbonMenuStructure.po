msgstr ""
"Outil permettant de placer le maillage sélectionné sur tout autre objet "
"choisi"

msgid "Fillers Test"
msgstr "Test de remplisseurs"

msgid "Swept Volume"
msgstr "Volume balayé"

msgid "Palette Test"
msgstr "Test de palette"

