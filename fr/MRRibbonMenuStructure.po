msgstr "Convertit les fonctionnalités sélectionnées en maillages."

msgid "Feature to Line"
msgstr "Fonctionnalité vers ligne"

msgid "Convert selected features to lines."
msgstr "Convertit les fonctionnalités sélectionnées en lignes."

msgid "Build Plate"
msgstr "Plateau de fabrication"

msgid "Configure Build Plate or load it from saved presets."
msgstr ""
"Configure le plateau de fabrication ou le charge à partir de préréglages "
"enregistrés."

