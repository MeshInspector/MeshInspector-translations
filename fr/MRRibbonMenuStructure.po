msgstr ""
"Affiche les coordonnées des points sélectionnés sur les objets sélectionnés."

msgid "Multi Clone"
msgstr "Clones multiples"

msgid "Create multiple copies of a selected object."
msgstr "Crée plusieurs copies d'un objet sélectionné."

msgid "Quality Control Report"
msgstr "Rapport de contrôle qualité"

