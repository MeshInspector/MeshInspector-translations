msgstr "Segmentation : créer des objets"

msgid "Select Component"
msgstr "Sélectionner le composant"

msgid "Select Largest Selection"
msgstr "Sélectionner la plus grande sélection"

msgid "Maximum length of edges to be selected."
msgstr "Longueur maximale des arêtes à sélectionner."

msgid "Select Short Edges"
msgstr "Sélectionner les arêtes courtes"

