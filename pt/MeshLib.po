msgid "Scale and Ratios"
msgstr "Escala e rácios"

#: source/MRViewer/MRViewerSettingsPlugin.cpp:753
msgid ""
"The number of digits to be shown after decimal point for dimensionless "
"measurements."
msgstr ""
"Número de dígitos a mostrar após o separador decimal para medições "
"adimensionais."

