msgstr "在网格表面单击两点以定义文本方向。"

msgid "Drag the points to adjust direction as needed."
msgstr "根据需要拖动点以调整方向。"

msgid "Applies only to multiline text"
msgstr "仅适用于多行文本"

msgid "Depth (-)/Height (+) "
msgstr "深度 (-)/高度 (+) "

msgid "Spacing"
msgstr "间距"

