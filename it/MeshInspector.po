msgstr "Numero massimo di punti adiacenti per un punto outlier"

msgid "neighbors"
msgstr "vicini"

msgid "points"
msgstr "punti"

msgid "Min Height Ratio"
msgstr "Rapporto altezza minimo"

msgid ""
"Minimum distance (as proportion of search radius) to the approximate surface "
