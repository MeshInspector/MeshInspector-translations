msgstr "두 거리 맵 사이의 최대, 최소 또는 차집합으로 거리 맵을 생성합니다."

msgid "Pixel Size"
msgstr "픽셀 크기"

msgid "Distance Threshold"
msgstr "거리 임계값"

msgid "Get Lines Critical points"
msgstr "선의 임계점 가져오기"

msgid "DMap Size"
msgstr "거리 맵 크기"

msgid "Origin Point"
msgstr "원점"

