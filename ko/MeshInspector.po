msgid "Sign detection method"
msgstr "부호 감지 방법"

msgid "Contours orientation"
msgstr "윤곽선 방향"

msgid "Recommended for oriented contours without self-intersections"
msgstr "자체 교차가 없는 방향이 정해진 윤곽선에 권장됩니다"

msgid "Winding rule"
msgstr "감기 규칙"

msgid ""
"Recommended for non-oriented contours or for contours with self-intersections"
msgstr "방향이 정해지지 않은 윤곽선 또는 자체 교차가 있는 윤곽선에 권장됩니다"

msgid "Resolution X"
msgstr "해상도 X"

msgid "Resolution Y"
msgstr "해상도 Y"

